    "@radix-ui/react-collapsible": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "cnfast": "^0.2.0",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-twoslash": "^4.0.2",
    "fumadocs-ui": "^16.17.5",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "zbsearch": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
