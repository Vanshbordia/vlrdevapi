{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vanshbordia/vlrdevapi",
  "title": "VLR.gg Dev API MCP Server",
  "description": "MCP server providing tools to fetch Valorant esports data, matches, events, and rankings from vlr.gg",
  "version": "3.1.1",
  "repository": {
    "url": "https://github.com/Vanshbordia/vlrdevapi",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "vlrdevapi",
      "version": "3.1.1",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "--from"
        },
        {
          "type": "positional",
          "value": "vlrdevapi[mcp]"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
